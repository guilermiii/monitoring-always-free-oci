# ==============================================================================
# OCI ALWAYS FREE MONITOR - ARQUIVO DE CONFIGURAÇÃO E VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Este arquivo serve de modelo para configuração local, GitHub Secrets e OCI Vault.
# Em produção (OCI / Kubeadm ARM), utilize valores seguros e habilite HTTPS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MODO DE OPERAÇÃO & PRIVACIDADE (PORTFOLIO MODE)
# ------------------------------------------------------------------------------
# Se 'true', ofusca agressivamente OCIDs, IPs públicos e nomes de instâncias
# para acessos não autenticados na internet pública.
PORTFOLIO_MODE=true

# ------------------------------------------------------------------------------
# 2. SEGURANÇA E AUTENTICAÇÃO ADMINISTRATIVA
# ------------------------------------------------------------------------------
# Usuário administrador único para login na interface
ADMIN_USERNAME=admin

# Hash Bcrypt da senha administrativa (Recomendado para produção).
# Gere com: python3 -c "import bcrypt; print(bcrypt.hashpw(b'SuaSenhaForteAqui', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=$2b$12$gUpW2ZwtM11c/JVvlFmoIuugQ3Q8/R21dq6BPmn06zKrAsZZflYjW

# Senha em texto plano (USAR APENAS EM DESENVOLVIMENTO LOCAL se ADMIN_PASSWORD_HASH estiver vazio)
# ADMIN_PASSWORD=admin123

# Segredo para assinatura de tokens JWT (HS256). Mínimo 64 caracteres hexadecimais.
# Gere com: openssl rand -hex 32
JWT_SECRET_KEY=2054d745e43fb42f70ed50d2cf4d452bdeed72bc45d28f2fa5e332a14802361d
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=4

# Configuração de Cookie de Sessão
SESSION_COOKIE_NAME=oci_admin_session

# OBRIGATÓRIO 'true' em produção com HTTPS (Let's Encrypt / Cert-Manager / OCI LB)
SESSION_COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 3. CONTROLE DE ACESSO, CORS E RATE LIMITING
# ------------------------------------------------------------------------------
# Origens permitidas (CORS). Em produção, defina o domínio oficial ou IP do Load Balancer
# Exemplo: https://monitor.seudominio.com,https://129.146.xxx.xxx
ALLOWED_ORIGINS=*

# Taxa máxima de requisições por minuto por IP
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=3

# ------------------------------------------------------------------------------
# 4. CACHE & PERSISTÊNCIA (REDIS & DISCO)
# ------------------------------------------------------------------------------
# Conexão com o Redis (no Kubernetes, aponte para o Service do Redis)
# Exemplo local: redis://redis:6379/0
# Exemplo K8s: redis://redis-service.oci-monitor.svc.cluster.local:6379/0
REDIS_URL=redis://redis:6379/0

# Intervalo entre coletas automáticas da OCI em background (segundos) - padrão 10 min
REFRESH_INTERVAL_SECONDS=600

# Tempo de expiração (TTL) das chaves de resumo no Redis (segundos) - padrão 15 min
CACHE_TTL_SECONDS=900

# Diretório para gravação contínua do histórico diário de chamadas de API
PERSISTENT_DATA_DIR=/app/data
API_USAGE_PERSISTENCE_FILE=/app/data/api_usage_history.json

# Desabilitar worker de fundo (usado apenas em testes unitários)
DISABLE_BACKGROUND_WORKER=false

# ------------------------------------------------------------------------------
# 5. COTAS E AUDITORIA DE CHAMADAS DE API OCI
# ------------------------------------------------------------------------------
# Limite de segurança de chamadas de API por dia (reseta à 00:00 UTC)
OCI_API_DAILY_LIMIT=10000

# Taxa de referência para prevenção de throttling (req/min)
OCI_API_RATE_LIMIT_PER_MIN=3000

# ------------------------------------------------------------------------------
# 6. CONFIGURAÇÃO DO OCI SDK & IDENTIDADE
# ------------------------------------------------------------------------------
# Caminho do arquivo de configuração ~/.oci/config (ou Secret montado no pod)
# Local: /home/appuser/.oci/config
# Kubernetes: /secrets/oci/config
OCI_CONFIG_FILE=/secrets/oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Caminho explícito para a chave privada RSA (.pem) caso não esteja referenciada no config
# OCI_KEY_FILE=/secrets/oci/oci_api_key.pem

# ------------------------------------------------------------------------------
# 7. PARÂMETROS PARA CADASTRO EM GITHUB SECRETS / OCI VAULT / K8S SECRET
# ------------------------------------------------------------------------------
# Preencha estes campos para facilitar a geração do Secret na nuvem
OCI_TENANCY_OCID=ocid1.tenancy.oc1..exemplo
OCI_USER_OCID=ocid1.user.oc1..exemplo
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=sa-saopaulo-1
# OCI_PRIVATE_KEY_CONTENT=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
